digraph g {
    Master_thread [shape=box]
    Master_thread_merged [shape=box]
    Thread1 [style="filled" fillcolor="#00BFFF"]
    Thread2 [style="filled" fillcolor="#00BFFF"]
    Thread3 [style="filled" fillcolor="#00BFFF"]
    Thread4 [style="filled" fillcolor="#00BFFF"]

    Master_thread -> {Thread1, Thread2, Thread3, Thread4}
    Thread1 -> Master_thread_merged
    Thread2 -> Master_thread_merged
    Thread3 -> Master_thread_merged
    Thread4 -> Master_thread_merged

}